{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "params": [{"name": "narrow", "expr": "containerSize()[0] < 560"}],
  "data": {
    "url": "data/programs_by_type.csv",
    "format": {"type": "csv", "parse": {"sessions": "number"}}
  },
  "width": "container",
  "height": {"step": 34},
  "title": {
    "fontSize": {"expr": "narrow ? 15 : 18"}, "subtitleFontSize": {"expr": "narrow ? 11 : 13"},
    "text": ["More than half of library programs", "go beyond reading"],
    "subtitle": "Program sessions by type, Australia 2024-25",
    "anchor": "start",
    "subtitleColor": "#666"
  },
  "transform": [
    {"joinaggregate": [{"op": "sum", "field": "sessions", "as": "total"}]},
    {"calculate": "datum.sessions / datum.total", "as": "share"},
    {
      "calculate": "format(datum.sessions, ',') + '  (' + format(datum.share, '.0%') + ')' + (datum.display_name == 'Hobbies & wellbeing' ? '   ▲ +35% in a year' : '')",
      "as": "label"
    }
  ],
  "encoding": {
    "y": {
      "field": "display_name",
      "type": "nominal",
      "title": null,
      "sort": {"field": "sessions", "order": "descending"},
      "axis": {
        "domain": false,
        "ticks": false,
        "labelFontSize": {"expr": "narrow ? 10 : 12"},
        "labelPadding": 8,
        "labelLimit": 0
      }
    },
    "x": {
      "field": "sessions",
      "type": "quantitative",
      "title": null,
      "axis": null,
      "scale": {"domain": [0, 240000]}
    },
    "color": {
      "condition": {
        "test": "datum.display_name == 'Reading & learning'",
        "value": "#CBD5E1"
      },
      "value": "#db2777"
    },
    "tooltip": [
      {"field": "display_name", "title": "Type"},
      {"field": "sessions", "type": "quantitative", "title": "Sessions", "format": ","},
      {"field": "share", "type": "quantitative", "title": "Share", "format": ".1%"},
      {"field": "report_name", "title": "Report category"}
    ]
  },
  "layer": [
    {
      "mark": {"type": "rule", "strokeWidth": 3},
      "encoding": {
        "x": {"datum": 0},
        "x2": {"field": "sessions"}
      }
    },
    {
      "mark": {"type": "circle", "size": 140, "opacity": 1}
    },
    {
      "mark": {"type": "text", "align": "left", "dx": 10, "fontSize": {"expr": "narrow ? 9 : 11"}},
      "encoding": {
        "text": {"field": "label"},
        "color": {"value": "#444"}
      }
    }
  ],
    "config": {
    "view": {"stroke": null},
    "title": {"anchor": "start", "fontSize": 18, "fontWeight": 700, "color": "#0F172A",
              "subtitleColor": "#64748B", "subtitleFontSize": 13, "offset": 10}
  }
}
