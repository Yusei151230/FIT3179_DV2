{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": ["More than 3 in 10 uses are now digital,", "up from 25 in 100 in 2020-21."],
    "subtitle": "Each square = 1 in 100 uses",
    "anchor": "start"
  },
  "data": {"url": "data/digital_share.csv"},
  "params": [
    {
      "name": "pick_year",
      "value": "2024-25",
      "bind": {
        "input": "select",
        "options": ["2020-21", "2021-22", "2022-23", "2023-24", "2024-25"],
        "name": "Financial year: "
      }
    }
  ],
  "transform": [
    {"filter": "datum.year == pick_year"}
  ],
  "width": 330,
  "height": 330,
  
  "layer": [
    {
        "mark": {"type": "square", "size": 300, "opacity": 1},
        "encoding": {
            "x": {"field": "col", "type": "ordinal", "axis": null},
            "y": {"field": "row", "type": "ordinal", "axis": null},
            "color": {
            "field": "type", "type": "nominal", "title": null,
            "scale": {"domain": ["Digital", "Physical"], "range": ["#3B82F6", "#99e2d8"]},
            "legend": {"orient": "bottom", "direction": "horizontal"}
            },
            "tooltip": [{"field": "year"}, {"field": "type"}]
            }
    },
        {
    "transform": [
        {"filter": "datum.type == 'Digital'"},
        {"aggregate": [{"op": "count", "as": "num"}], "groupby": ["type"]},
        {"calculate": "datum.num + '%'","as": "pct"}
    ],
    "mark": {"type": "text", "fontSize": 28, "fontWeight": "bold", "color": "#1E3A8A"},
    "encoding": {
        "x": {"value": 150},
        "y": {"value": 45},
        "text": {"field": "pct"}
    }
    },
{
  "transform": [
    {"filter": "datum.type == 'Digital'"},
    {"aggregate": [{"op": "count", "as": "num"}], "groupby": ["type"]},
    {"calculate": "datum.num + '%'", "as": "pct"}
  ],
  "layer": [
    {
      "mark": {"type": "text", "fontSize": 28, "fontWeight": "bold",
               "color": "white", "stroke": "white", "strokeWidth": 6, "strokeJoin": "round"},
      "encoding": {"x": {"value": 150}, "y": {"value": 45}, "text": {"field": "pct"}}
    },
    {
      "mark": {"type": "text", "fontSize": 28, "fontWeight": "bold", "color": "#4c2a85"},
      "encoding": {"x": {"value": 150}, "y": {"value": 45}, "text": {"field": "pct"}}
    }
  ]
},
{
  "transform": [
    {"filter": "datum.type == 'Physical'"},
    {"aggregate": [{"op": "count", "as": "num"}], "groupby": ["type"]},
    {"calculate": "datum.num + '%'", "as": "pct"}
  ],
  "layer": [
    {
      "mark": {"type": "text", "fontSize": 28, "fontWeight": "bold",
               "color": "white", "stroke": "white", "strokeWidth": 6, "strokeJoin": "round"},
      "encoding": {"x": {"value": 150}, "y": {"value": 210}, "text": {"field": "pct"}}
    },
    {
      "mark": {"type": "text", "fontSize": 28, "fontWeight": "bold", "color": "#0f766e"},
      "encoding": {"x": {"value": 150}, "y": {"value": 210}, "text": {"field": "pct"}}
    }
  ]
},
    {
    "transform": [
        {"filter": "datum.type == 'Digital'"},
        {"aggregate": [{"op": "count", "as": "num"}], "groupby": ["type"]},
        {"calculate": "datum.num + '%'","as": "pct"}
    ],
    "mark": {"type": "text", "fontSize": 28, "fontWeight": "bold", "color": "#1E3A8A"},
    "encoding": {
        "x": {"value": 150},
        "y": {"value": 45},
        "text": {"field": "pct"}
    }
    },
    {
        "transform": [
            {"filter": "datum.type == 'Physical'"},
            {"aggregate": [{"op": "count", "as": "num"}], "groupby": ["type"]},
            {"calculate": "datum.num + '%'","as": "pct"}
        ],
        "mark": {"type": "text", "fontSize": 28, "fontWeight": "bold", "color": "#475569"},
        "encoding": {
            "x": {"value": 150},
            "y": {"value": 210},
            "text": {"field": "pct"}
        }
    }
  ],
    "config": {
    "view": {"stroke": null},
    "title": {"anchor": "start", "fontSize": 18, "fontWeight": 700, "color": "#0F172A",
              "subtitleColor": "#64748B", "subtitleFontSize": 13, "offset": 10}
  }
}