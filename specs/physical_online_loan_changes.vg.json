{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "params": [{"name": "narrow", "expr": "containerSize()[0] < 560"}],
    "title": {
        "fontSize": {"expr": "narrow ? 15 : 18"}, "subtitleFontSize": {"expr": "narrow ? 11 : 13"},
        "text": "Digital use grew 80% in five years",
        "subtitle": {"expr": "narrow ? ['Change since 2020-21.', 'Digital use includes ebooks, databases and streaming.'] : 'Change since 2020-21. Digital use includes ebooks, databases and streaming.'"},
        "anchor": "start"
    },
    "data": {"url": "data/physical_online_loan_changes.csv"},
    "width": "container",
    "height": "container",
    
    "layer": [
        
        {
            "data": {"values": [{}]},
            "mark": {"type": "rect", "opacity": 0.3},
            "encoding": {
                "x": {"datum": "2020-21"},
                "x2": {"datum": "2021-22"},
                "y": {"value": 0},
                "y2": {"value": "height"},
                "color": {"value": "#e5e7eb"}
            }
        },
        {
            "data": {"values": [{}]},
            "mark": {"type": "text", "text": "COVID-19 lockdowns", "align": "left", "dx": 6,
                    "baseline": "top", "dy": 6, "fontSize": {"expr": "narrow ? 9 : 11"}, "fontWeight": 600},
            "encoding": {
            "x": {"datum": "2020-21"},
            "y": {"value": 0},
            "color": {"value": "#6b7280"}
            }
        },
        {
            "mark": {"type": "line", "point": true, "strokeWidth": 3},
            "encoding": {
                "x": {
                    "field": "year", "type": "ordinal", "title": "Financial year",
                    "axis": {"labelAngle": 0}
                },
                "y": {
                    "field": "change_since_2020-21_pct", "type": "quantitative",
                    "title": "Change since 2020-21 (%)",
                    "scale": {"domain": [0, 90]}
                },
                "color": {
                    "field": "series", "type": "nominal", "title": null,
                    "scale": {
                        "domain": ["Physical loans", "Digital use"],
                        "range": ["#99e2d8", "#3B82F6"]
                    },
                    "legend": {"orient": "top", "direction": "horizontal"}
                },
                "tooltip": [
                    {"field": "series", "title": "Type"},
                    {"field": "year", "title": "Financial year"},
                    {"field": "value_millions", "type": "quantitative", "title": "Uses (millions)", "format": ".1f"},
                    {"field": "change_since_2020-21_pct", "type": "quantitative", "title": "Change since 2020-21 (%)", "format": "+.1f"}
                ]
            }
        },
        {
            "mark": {"type": "rule", "color": "lightgray", "strokeDash": [4, 4]},
            "encoding": {
                "x": {"datum": "2024-25", "type": "ordinal"}
            }
        },
       {
            "transform": [
                {"filter": "datum.year == '2024-25'"},
                {"calculate": "'+' + round(datum['change_since_2020-21_pct']) + '%'", "as": "pct_label"}
            ],
            "mark": {"type": "text", "align": "left", "dx": 10, "dy": -8, "fontWeight": "bold"},
            "encoding": {
                "x": {"field": "year", "type": "ordinal"},
                "y": {"field": "change_since_2020-21_pct", "type": "quantitative"},
                "color": {"field": "series", "type": "nominal"},
                "text": {"field": "pct_label"},
                "size": {
                    "condition": {"test": "datum.series == 'Digital use'", "value": {"expr": "narrow ? 14 : 18"}},
                    "value": {"expr": "narrow ? 11 : 13"}
                }
            }
        }
    ],
      "config": {
    "view": {"stroke": null},
    "title": {"anchor": "start", "fontSize": 18, "fontWeight": 700, "color": "#0F172A",
              "subtitleColor": "#64748B", "subtitleFontSize": 13, "offset": 10}
  }
}