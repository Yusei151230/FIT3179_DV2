{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "params": [
    {"name": "narrow", "expr": "containerSize()[0] < 560"}
  ],
  "title": {
    "text": {"expr": "narrow ? ['Millions of collections, visits', 'and loans, and visits grew the most'] : 'Millions of collections, visits and loans, and visits grew the most'"},
    "fontSize": {"expr": "narrow ? 15 : 18"}
  },
  "data": {"url": "data/visits_collection_loans_physical_2020-2025.csv"},
  "width": "container",
  "height": "container",
  "padding": {"right": 20},
  "transform": [
    {
      "window": [{"op": "first_value", "field": "value", "as": "start_value"}],
      "groupby": ["measure"],
      "sort": [{"field": "year"}],
      "frame": [null, null]
    }
  ],
  "encoding": {
    "x": {"field": "year", "type": "ordinal", "title": "Financial year", "axis": {
      "labelAngle": 0,
      "labelFontSize": {"expr": "narrow ? 9 : 10"},
      "labelExpr": "narrow ? substring(datum.label, 2) : datum.label"
    }},
    "y": {"field": "value", "type": "quantitative", "title": "Count", "axis": {
      "format": "~s",
      "labelFontSize": {"expr": "narrow ? 9 : 10"}
    }},
    "color": {
      "field": "measure",
      "type": "nominal",
      "title": "Measure",
      "scale": {
        "domain": ["In-person visits", "Physical loans", "Physical collection"],
        "range": ["#F43F5E", "#99e2d8", "#b0b7b5"]
      },
      "legend": {
        "orient": "top", "labelLimit": 0,
        "labelFontSize": {"expr": "narrow ? 9 : 11"},
        "symbolSize": {"expr": "narrow ? 60 : 100"},
        "columnPadding": {"expr": "narrow ? 6 : 10"}
      }
    }
  },
  "layer": [
        {
      "data": {"values": [{}]},
      "mark": {"type": "rect", "opacity": 0.3},
      "encoding": {
        "x": {"datum": "2020-21"},
        "x2": {"datum": "2021-22"},
        "y": {"value": 0},
        "y2": {"value": "height"},
        "color": {"value": "#e5e7eb"}
      }
    },
      {
    "data": {"values": [{}]},
    "mark": {"type": "text", "text": {"expr": "narrow ? 'COVID-19' : 'COVID-19 lockdowns'"},
             "align": "left", "dx": {"expr": "narrow ? 3 : 6"},
             "baseline": "top", "dy": 6, "fontSize": {"expr": "narrow ? 9 : 11"}, "fontWeight": 600},
    "encoding": {
      "x": {"datum": "2020-21"},
      "y": {"value": 0},
      "color": {"value": "#6b7280"}
    }
  },
    {
      "mark": {"type": "line", "point": true},
      "encoding": {
        "tooltip": [
          {"field": "measure", "title": "Measure"},
          {"field": "year", "title": "Year"},
          {"field": "value", "type": "quantitative", "title": "Value", "format": ","}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.end_label"}],
      "mark": {"type": "rule", "strokeDash": [4, 4], "strokeWidth": 1},
      "encoding": {
        "x": {"datum": "2020-21"},
        "x2": {"field": "year"},
        "y": {"field": "start_value", "type": "quantitative"}
      }
    },
    {
      "transform": [{"filter": "datum.end_label"}],
      "mark": {"type": "rule", "strokeDash": [4, 4], "strokeWidth": 1},
      "encoding": {
        "y2": {"field": "start_value"}
      }
    },
    {
      "transform": [{"filter": "datum.end_label"}],
      "mark": {"type": "point", "filled": true},
      "encoding": {
        "y": {"field": "start_value", "type": "quantitative"}
      }
    },

    {
      "transform": [
        {"filter": "datum.end_label"},
        {"calculate": "format(toNumber(datum['change_from_2020-21_pct']), '+.2~r') + '%'", "as": "pct_label"}
      ],
      "mark": {"type": "text", "align": "left", "dx": 8, "fontWeight": "bold"},
      "encoding": {
        "text": {"field": "pct_label"},
        "size": {
          "condition": {"test": "datum.measure == 'In-person visits'", "value": {"expr": "narrow ? 14 : 18"}},
          "value": {"expr": "narrow ? 11 : 14"}
        }
      }
    },
    {
      "transform": [{"filter": "datum.end_label"}],
      "mark": {"type": "text", "text": "since 2020-21", "align": "left", "dx": 8,
               "dy": {"expr": "narrow ? 13 : 16"}, "fontSize": {"expr": "narrow ? 9 : 11"}}
    }
  ],
    "config": {
    "view": {"stroke": null},
    "title": {"anchor": "start", "fontSize": 18, "fontWeight": 700, "color": "#0F172A",
              "subtitleColor": "#64748B", "subtitleFontSize": 13, "offset": 10}
  }
}