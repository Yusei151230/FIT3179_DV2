{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "params": [{"name": "narrow", "expr": "containerSize()[0] < 560"}],
  "title": {
    "fontSize": {"expr": "narrow ? 15 : 18"}, "subtitleFontSize": {"expr": "narrow ? 11 : 13"},
    "text": "Public libraries across Australia",
    "subtitle": "Each dot is one library (locations as of 2018)"
  },
  "width": "container",
  "height": "container",
  "projection": {
  "type": "conicEqualArea",
  "parallels": [-18, -36],
  "rotate": [-132, 0]
},
  "layer": [
    {
      "data": {
        "url": "data/ne_10m_admin_1_states_provinces.json",
        "format": {"type": "topojson", "feature": "ne_10m_admin_1_states_provinces"}
      },
      "transform": [{"filter": "datum.properties.admin == 'Australia'"}],
      "mark": {"type": "geoshape", "fill": "#e6e6e6", "stroke": "white"}
    },
    {
      "data": {"url": "data/libraries_australia_2018.csv"},
      "mark": {"type": "circle", "size": 10, "opacity": 0.6, "color": "#4F46E5"},
      "encoding": {
        "latitude": {"field": "latitude", "type": "quantitative"},
        "longitude": {"field": "longitude", "type": "quantitative"},
        "tooltip": [
          {"field": "Library", "title": "Library"},
          {"field": "Suburb", "title": "Suburb"}
        ]
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "title": {"anchor": "start", "fontSize": 18, "fontWeight": 700, "color": "#0F172A",
              "subtitleColor": "#64748B", "subtitleFontSize": 13, "offset": 10}
  }
}
