{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": ["In 7 of 8 states, over 30% of library use is digital","and in two it is about 40% or more"],
    "subtitle": [
      "Share of digital collection use: Digital = ebooks, databases and streaming."
    ]
  },
  "width": "container",
  "height": 380,
  "projection": {
  "type": "conicEqualArea",
  "parallels": [-18, -36],
  "rotate": [-132, 0]
},
  "layer": [
    {
      "data": {
        "url": "data/ne_10m_admin_1_states_provinces.json",
        "format": {"type": "topojson", "feature": "ne_10m_admin_1_states_provinces"}
      },
      "transform": [
        {
          "lookup": "properties.name",
          "from": {
            "data": {"url": "data/digital_share_by_state.csv"},
            "key": "state_name",
            "fields": ["digital_share_pct"]
          }
        }
      ],
      "layer": [
        {
          "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 1.2},
          "encoding": {
            "color": {
              "field": "digital_share_pct", "type": "quantitative", "title": "Digital share",
              "scale": {"domain": [25, 45], "range": ["#DBEAFE", "#3B82F6", "#1E3A8A"]},
              "legend": {
                "orient": "bottom-left", "direction": "horizontal", "gradientLength": 150,
                "values": [25, 30, 35, 40, 45], "labelExpr": "datum.value + '%'",
                "titleFontSize": 11, "labelFontSize": 10, "titleColor": "#334155", "labelColor": "#64748B"
              }
            },
            "tooltip": [
              {"field": "properties.name", "title": "State"},
              {"field": "digital_share_pct", "title": "Digital share (%)", "format": ".1f"}
            ]
          }
        }
      ]
    },
    {
      "data": {"url": "data/digital_share_by_state.csv"},
      "transform": [
        {"calculate": "datum.state == 'ACT' || datum.state == 'TAS' ? toNumber(datum.longitude) + 2.5 : datum.longitude", "as": "indicator_lon"},
        {"calculate": "datum.state == 'ACT' || datum.state == 'TAS' ? toNumber(datum.longitude) + 4 : datum.longitude", "as": "lab_lon"},
        {"calculate": "datum.state == 'ACT' ? 'ACT' : datum.state_name", "as": "lab_text"},
        {"calculate": "round(datum.digital_share_pct) + '%'", "as": "pct_label"},
        {"calculate": "datum.state == 'ACT' || datum.state == 'TAS'", "as": "outside"},
        {"calculate": "!datum.outside && datum.digital_share_pct >= 38", "as": "on_dark"}
      ],
      "layer": [
        {
          "transform": [{"filter": "datum.outside"}],
          "mark": {"type": "rule", "color": "#64748B", "strokeWidth": 1},
          "encoding": {
            "longitude": {"field": "longitude", "type": "quantitative"},
            "latitude": {"field": "latitude", "type": "quantitative"},
            "longitude2": {"field": "indicator_lon"},
            "latitude2": {"field": "latitude"}
          }
        },
        {
          "transform": [{"filter": "!datum.outside"}],
          "mark": {"type": "text", "baseline": "bottom", "dy": -1, "fontSize": 11, "fontWeight": 500, "align": "center"},
          "encoding": {
            "longitude": {"field": "lab_lon", "type": "quantitative"},
            "latitude": {"field": "latitude", "type": "quantitative"},
            "text": {"field": "state_name"},
            "color": {"condition": {"test": "datum.on_dark", "value": "#E0E7FF"}, "value": "#334155"}
          }
        },
        {
          "transform": [{"filter": "!datum.outside"}],
          "mark": {"type": "text", "baseline": "top", "dy": 1, "fontSize": 17, "fontWeight": 700, "align": "center"},
          "encoding": {
            "longitude": {"field": "lab_lon", "type": "quantitative"},
            "latitude": {"field": "latitude", "type": "quantitative"},
            "text": {"field": "pct_label"},
            "color": {"condition": {"test": "datum.on_dark", "value": "white"}, "value": "#0F172A"}
          }
        },
        {
          "transform": [{"filter": "datum.outside"}],
          "mark": {"type": "text", "baseline": "bottom", "dy": -1, "dx": 4, "fontSize": 11, "fontWeight": 500, "align": "center", "color": "#334155"},
          "encoding": {
            "longitude": {"field": "lab_lon", "type": "quantitative"},
            "latitude": {"field": "latitude", "type": "quantitative"},
            "text": {"field": "lab_text"}
          }
        },
        {
          "transform": [{"filter": "datum.outside"}],
          "mark": {"type": "text", "baseline": "top", "dy": 1, "dx": 4, "fontSize": 17, "fontWeight": 700, "align": "center", "color": "#0F172A"},
          "encoding": {
            "longitude": {"field": "lab_lon", "type": "quantitative"},
            "latitude": {"field": "latitude", "type": "quantitative"},
            "text": {"field": "pct_label"}
          }
        }
      ]
    }
  ],
  "config": {
    "view": {"stroke": null},
    "title": {"anchor": "start", "fontSize": 17, "fontWeight": 700, "color": "#0F172A",
              "subtitleColor": "#64748B", "subtitleFontSize": 12, "offset": 12}
  }
}
